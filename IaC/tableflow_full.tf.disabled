# Tableflow and S3 configuration for fact tables
# Enables Flink tables to write to S3 as Parquet/Iceberg

# AWS Provider for S3 and IAM resources
# (AWS provider is declared in main.tf required_providers)
provider "aws" {
  region = var.cloud_region
}

# ------------------------------------------------------
# S3 Bucket for Analytics Data
# ------------------------------------------------------

resource "aws_s3_bucket" "analytics" {
  bucket = "${var.prefix}-healthcare-analytics-${random_id.bucket_suffix.hex}"

  tags = {
    Name        = "Healthcare Analytics Data"
    Environment = local.environment_id
    ManagedBy   = "Terraform"
    Project     = "healthcare-shift-left-demo"
  }
}

resource "random_id" "bucket_suffix" {
  byte_length = 4
}

resource "aws_s3_bucket_versioning" "analytics" {
  bucket = aws_s3_bucket.analytics.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "analytics" {
  bucket = aws_s3_bucket.analytics.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# Lifecycle policy to manage old data
resource "aws_s3_bucket_lifecycle_configuration" "analytics" {
  bucket = aws_s3_bucket.analytics.id

  rule {
    id     = "expire-old-data"
    status = "Enabled"

    filter {}  # Apply to all objects

    expiration {
      days = 90
    }

    noncurrent_version_expiration {
      noncurrent_days = 30
    }
  }
}

# ------------------------------------------------------
# IAM Role and Policy for Confluent Tableflow
# ------------------------------------------------------

# IAM role that Confluent Tableflow will assume
resource "aws_iam_role" "tableflow" {
  name = "${var.prefix}-tableflow-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          AWS = "arn:aws:iam::${var.confluent_aws_account_id}:root"
        }
        Action = "sts:AssumeRole"
        Condition = {
          StringEquals = {
            "sts:ExternalId" = var.confluent_external_id
          }
        }
      }
    ]
  })

  tags = {
    Name      = "Confluent Tableflow Role"
    ManagedBy = "Terraform"
    Project   = "healthcare-shift-left-demo"
  }
}

# IAM policy for S3 access
resource "aws_iam_policy" "tableflow_s3" {
  name        = "${var.prefix}-tableflow-s3-policy"
  description = "Allow Confluent Tableflow to write to S3 analytics bucket"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
          "s3:ListBucket"
        ]
        Resource = [
          aws_s3_bucket.analytics.arn,
          "${aws_s3_bucket.analytics.arn}/*"
        ]
      },
      {
        Effect = "Allow"
        Action = [
          "s3:ListAllMyBuckets"
        ]
        Resource = "*"
      }
    ]
  })
}

# Attach policy to role
resource "aws_iam_role_policy_attachment" "tableflow_s3" {
  role       = aws_iam_role.tableflow.name
  policy_arn = aws_iam_policy.tableflow_s3.arn
}

# ------------------------------------------------------
# Tableflow Connections (one per fact table)
# ------------------------------------------------------

# Tableflow connection for hc_fct_dev_anomaly
resource "confluent_tableflow_connection" "dev_anomaly" {
  count = var.enable_tableflow ? 1 : 0

  display_name = "hc_fct_dev_anomaly_s3"

  environment {
    id = local.environment_id
  }

  credentials {
    aws_iam_role {
      iam_role_arn = aws_iam_role.tableflow.arn
      external_id  = var.confluent_external_id
    }
  }

  lifecycle {
    prevent_destroy = false
  }
}

# Tableflow sink for hc_fct_dev_anomaly
resource "confluent_tableflow_sink" "dev_anomaly" {
  count = var.enable_tableflow ? 1 : 0

  display_name = "hc_fct_dev_anomaly_to_s3"

  environment {
    id = local.environment_id
  }

  connection {
    id = confluent_tableflow_connection.dev_anomaly[0].id
  }

  source_table {
    catalog_name  = local.environment_id
    database_name = local.kafka_cluster_id
    name          = "hc_fct_dev_anomaly"
  }

  target_table {
    storage_uri = "s3://${aws_s3_bucket.analytics.bucket}/anomalies"
    format      = "PARQUET"

    partition_columns = ["date"]
  }

  lifecycle {
    prevent_destroy = false
  }
}

