# Copy to terraform.tfvars (this directory = Confluent core only). Do not commit secrets.
# Flink SQL statements: use ../flink-statements/  |  S3/Tableflow IAM: use ../aws/

# Required: Confluent Cloud API credentials (for Terraform resource management)
confluent_cloud_api_key    = "<TO FILL>"
confluent_cloud_api_secret = "<TO_FILL>"

# Cloud configuration (from CLOUD_PROVIDER / CLOUD_REGION)
cloud_provider = "AWS"
cloud_region   = "us-west-2"

# Resource naming
prefix = "health"

# Flink compute pool (only when Terraform creates the pool; ignored when flink_compute_pool_id is set)
# flink_compute_pool_name    = "healthcare-demo-pool"
flink_compute_pool_max_cfu = 5

# ------------------------------------------
# Optional: use existing Confluent infrastructure
# ------------------------------------------
# environment_id   = "env-r69ry1"
# kafka_cluster_id = "lkc-jxqypp"
# service_account_id = "sa-gqvnrzm"
# flink_compute_pool_id = "lfcp-916r8m"

# Existing API keys (optional; otherwise Terraform creates demo keys in app_credentials.tf)
# kafka_api_key_id     = "..."
# kafka_api_key_secret = "..."
# schema_registry_api_key_id     = "..."
# schema_registry_api_key_secret = "..."
# flink_api_key_id     = "..."
# flink_api_key_secret = "..."
