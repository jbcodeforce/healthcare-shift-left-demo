# Copy to terraform.tfvars and set your values.
# Do not commit terraform.tfvars (it may contain secrets).

# Required: Confluent Cloud API credentials
# confluent_cloud_api_key    = "..."
# confluent_cloud_api_secret = "..."

# Optional: cloud and region (defaults shown)
# cloud_provider = "AWS"
# cloud_region   = "us-east-1"
# prefix         = "healthcare-demo"

# Optional: use existing environment and/or Kafka cluster (leave unset to create new)
# When set, Terraform will not create these resources and will use the existing ones.
# If kafka_cluster_id is set, environment_id must also be set.
# environment_id    = null
# kafka_cluster_id  = null

# Example: use existing environment and Kafka cluster
# environment_id   = "env-xxxxx"
# kafka_cluster_id = "lkc-xxxxx"

# Optional: use existing service account (leave unset to create new)
# When set, Terraform will not create a service account and will use the existing one.
# API keys will still be created for this service account.
# service_account_id = null

# Example: use existing service account
# service_account_id = "sa-xxxxx"

# Optional: use existing Flink compute pool (leave unset to create new)
# When set, Terraform will not create a Flink compute pool and will use the existing one.
# environment_id must also be set when using existing Flink compute pool.
# flink_compute_pool_id = null

# Example: use existing Flink compute pool
# flink_compute_pool_id = "lfcp-xxxxx"

# Flink compute pool
# flink_compute_pool_name = "healthcare-demo-pool"
# flink_compute_pool_max_cfu = 5

# Kafka / Schema Registry / Flink API keys for the demo app are created by Terraform
# (see app_credentials.tf). After apply: terraform output -raw backend_env_snippet

# Flink statement deployment
# deploy_flink_statements = true
# statement_name_prefix   = "hc-demo"

# Tableflow and S3 configuration (for writing Flink data to S3)
# Enable this after Flink tables are created and running
# enable_tableflow = false

# External ID for Confluent Tableflow IAM role (obtain from Confluent support or docs)
# confluent_external_id = "your-external-id-here"

# Confluent AWS Account ID (default is Confluent's account for Tableflow)
# confluent_aws_account_id = "761327592718"
