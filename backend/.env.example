# Terraform (IaC/): from repo root, `source ./export_terraform_env.sh` then `cd IaC && terraform plan`.
# Or `source ./set_j9r_env_sl` (loads this file + shift_left + TF_VAR_*).
# Mapped to TF_VAR_*: CONFLUENT_CLOUD_API_KEY/SECRET, CLOUD_PROVIDER, CLOUD_REGION,
# ENVIRONMENT_ID or FLINK_ENV_ID or ENV_ID, optional KAFKA_CLUSTER_ID, FLINK_API_KEY/SECRET,
# PRINCIPAL_ID; optional PREFIX, FLINK_COMPUTE_POOL_NAME, DEPLOY_FLINK_STATEMENTS,
# STATEMENT_NAME_PREFIX. terraform.tfvars overrides overlapping Terraform variables.
#
# Minimum settings to use with Terraform and create all resources
CLOUD_PROVIDER="aws"
CLOUD_REGION="us-west-2"
ORG_ID=""
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=cflt...


# Specific to Confluent Cloud
CONFLUENT_CLOUD_REST_ENDPOINT="https://api.confluent.cloud"
ENV_ID="env-xxxxxxxx"

# Specific to Flink
COMPUTE_POOL_ID="lfcp-xxxxxxxx"
FLINK_ENV_ID=${ENV_ID}
FLINK_ENV_NAME="your-env-display-name"
FLINK_DATABASE_NAME="your-kafka-cluster-display-name"
FLINK_ORG_ID=${ORG_ID}
FLINK_REST_ENDPOINT=https://flink.region.provider.confluent.cloud
# Service account that owns the Flink API key
PRINCIPAL_ID=sa-xxxxxxxx
FLINK_API_KEY=
FLINK_API_SECRET=cfltx...
SCHEMA_SUBJECT_PREFIX=.flink-dev
FLINK_COMPUTE_POOL_ID="lfcp-xxxxxxxx"


# Specific to Kafka
KAFKA_BOOTSTRAP_SERVERS="pkc-xxxxx.region.provider.confluent.cloud:9092"
KAFKA_API_KEY=your_cluster_api_key
KAFKA_API_SECRET=your_cluster_api_secret
KAFKA_REST_ENDPOINT="https://pkc-xxxxx.region.provider.confluent.cloud:443"
KAFKA_CLUSTER_ID="lkc-xxxxxxxx"
KAFKA_SASL_USERNAME=${KAFKA_API_KEY}
KAFKA_SASL_PASSWORD=${KAFKA_API_SECRET}
# KAFKA_TOPIC=hc_device_metrics
KAFKA_DEVICE_EVENTS_TOPIC=hc_raw_device_events
KAFKA_DEVICE_ASSIGNMENTS_TOPIC=hc_src_device_assignments
KAFKA_CARE_AREAS_TOPIC=hc_dim_care_areas
KAFKA_UPDATE_ALLOWLIST_TOPIC=hc_src_device_update_allowlist

# Schema Registry (Confluent Cloud)
SCHEMA_REGISTRY_URL="https://psrc-xxxxx.region.provider.confluent.cloud"
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=your_sr_key:your_sr_secret
# Optional: non-default schema context (backend appends /contexts/<name> when set)
# SCHEMA_REGISTRY_CONTEXT=my-context

# Aliases used by other CLI
KAFKA_ENV_ID=${ENV_ID}
ENVIRONMENT_ID=${ENV_ID}
ORGANIZATION_ID=${ORG_ID}

# Specific to the demonstration
# POSTGRES_USER and POSTGRES_PASSWORD are required for the connector; others have defaults.
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=healthcare
DEBEZIUM_TOPIC_PREFIX=healthcare
TABLE_INCLUDE_LIST=public.prescriptions
DEBEZIUM_CONNECTOR_NAME=debezium-postgres-healthcare
CONNECT_URL=http://localhost:8083

# ---------------------------------------------------------------------------
# Optional (backend / local dev — not required for the minimal layout above)
# ---------------------------------------------------------------------------

# PostgreSQL URL when not using docker-compose defaults
# DATABASE_URL=postgresql://demo:demo@localhost:5432/healthcare

# Simulation
# SIMULATION_INTERVAL_SECONDS=2.0
# SIMULATION_NUM_PATIENTS=5

# Analytics (S3 Parquet / DuckDB dashboard)
# ANALYTICS_S3_BUCKET=
# ANALYTICS_S3_PREFIX=
# ANALYTICS_LOCAL_PATH=../analytics/sample-data/parquet
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
