# Confluent Cloud Kafka (required for simulation / telemetry to Kafka and for Kafka Connect)
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_API_KEY=your_cluster_api_key
KAFKA_API_SECRET=your_cluster_api_secret
# Kafka Connect (Debezium) uses the same cluster; set these for docker-compose (backend and kafka-connect)
KAFKA_SASL_USERNAME=your_cluster_api_key
KAFKA_SASL_PASSWORD=your_cluster_api_secret
KAFKA_TOPIC=device_metrics

CLOUD_PROVIDER="aws"
CLOUD_REGION="us-west-2"
ORG_ID=""
ENV_ID="env-"
COMPUTE_POOL_ID="lfcp-"

KAFKA_ENV_ID=${ENV_ID}
FLINK_ENV_ID=${ENV_ID}
ENVIRONMENT_ID=${ENV_ID}
ORGANIZATION_ID=${ORG_ID}

FLINK_REST_ENDPOINT=https://flink.....confluent.cloud
# j9r-flink-app service account key
PRINCIPAL_ID=sa-
FLINK_API_KEY=
FLINK_API_SECRET=cfltx....

FLINK_ORG_ID=${ORG_ID}
FLINK_ENV_NAME="j9r-env"
FLINK_DATABASE_NAME="j9r-kafka"
FLINK_COMPUTE_POOL_ID="lfcp-..."


# Confluent Cloud Schema Registry
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=your_sr_key:your_sr_secret
# Subject name prefix at converter level (producer and Connect): subject format ":{prefix}:{topic}-key" / ":{prefix}:{topic}-value"
# Same as backend config schema_subject_prefix; default .flink-dev
# SCHEMA_SUBJECT_PREFIX=.flink-dev
# Optional: non-default schema context via URL (entrypoint appends /contexts/<name> when set)
# SCHEMA_REGISTRY_CONTEXT=my-context

# Simulation (optional)
# SIMULATION_INTERVAL_SECONDS=2.0
# SIMULATION_NUM_PATIENTS=5

# PostgreSQL (optional; when running with docker-compose, DATABASE_URL is set automatically)
# Used by backend and by Kafka Connect (Debezium) for CDC. For Debezium, ensure wal_level=logical (see docker-compose postgres command).
# DATABASE_URL=postgresql://demo:demo@localhost:5432/healthcare
#
# Debezium connector (connect/register-connector.sh and connect/debezium-postgres.json)
# Same backend/.env is used by docker-compose for the Connect worker and by register-connector.sh for the connector config.
# POSTGRES_USER and POSTGRES_PASSWORD are required for the connector; others have defaults.
# POSTGRES_USER=demo
# POSTGRES_PASSWORD=demo
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=healthcare
# DEBEZIUM_TOPIC_PREFIX=healthcare
# TABLE_INCLUDE_LIST=public.prescriptions
# DEBEZIUM_CONNECTOR_NAME=debezium-postgres-healthcare
# CONNECT_URL=http://localhost:8083
