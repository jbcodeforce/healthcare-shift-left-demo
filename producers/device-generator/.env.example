# Confluent Cloud Kafka
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_SASL_USERNAME=your_cluster_api_key
KAFKA_SASL_PASSWORD=your_cluster_api_secret
KAFKA_TOPIC=device-metrics

# Confluent Cloud Schema Registry
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=your_sr_key:your_sr_secret

# Simulation (optional)
# SIMULATION_INTERVAL_SECONDS=2.0
# SIMULATION_NUM_PATIENTS=5
