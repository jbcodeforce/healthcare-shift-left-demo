# shellcheck shell=bash
_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$_REPO_ROOT/set_env_var"

export SL_KAFKA_API_KEY=$KAFKA_API_KEY
export SL_KAFKA_API_SECRET=$KAFKA_API_SECRET
