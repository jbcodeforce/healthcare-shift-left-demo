export SL_CONFLUENT_CLOUD_API_SECRET=$CONFLUENT_CLOUD_API_SECRET
export SL_CONFLUENT_PRINCIPAL_ID=$PRINCIPAL_ID

export FLINK_PROJECT=$_REPO_ROOT
export PIPELINES=$FLINK_PROJECT/pipelines
export CONFIG_FILE=$_REPO_ROOT/scripts/config-ccloud.yaml

export CCLOUD_KAFKA_CLUSTER=$FLINK_DATABASE_NAME
